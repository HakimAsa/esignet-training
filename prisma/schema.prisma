generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  // Stable OIDC subject identifier from eSignet (the "sub" claim). Null for users
  // created outside the eSignet login flow (e.g. via the plain POST /api/users
  // example endpoint); set and unique for anyone who has signed in via eSignet.
  sub       String?  @unique
  email     String?  @unique
  name      String?
  // Every eSignet claim the user actually consented to (name, picture,
  // birthdate, gender, phone_number, address, individual_id, ...), verbatim.
  // Kept generic rather than one column per possible claim, so the dashboard
  // can display exactly what was shared — no schema change needed when a
  // client is onboarded for a new claim.
  profile   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
