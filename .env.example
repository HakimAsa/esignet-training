NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=esignet
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esignet?schema=public
# Using a hosted Postgres (Supabase, Neon, etc.) instead of the local Docker one?
# - Supabase: use the "Session pooler" host (port 5432), not the direct "db.<ref>.supabase.co"
#   one — that one is IPv6-only and unreachable from IPv4-only networks/hosts.
# - Append &uselibpqcompat=true alongside sslmode=require if you hit
#   "self-signed certificate in certificate chain" — newer pg versions treat
#   sslmode=require as full cert verification by default, which most managed
#   Postgres providers' certs fail; this flag restores the traditional
#   encrypt-but-don't-verify behavior sslmode=require is normally expected to have.

# Comma-separated list of allowed CORS origins (your frontend's origin(s))
CORS_ORIGIN=http://localhost:5174

# eSignet (MOSIP OIDC) relying-party config
ESIGNET_CLIENT_ID=
# PKCS8 PEM private key used to sign the private_key_jwt client assertion.
ESIGNET_PRIVATE_KEY=
# kid of the public key registered with eSignet for this client.
ESIGNET_KEY_ID=
# Random 32+ char secret used to sign our own session cookie (openssl rand -base64 32).
ESIGNET_SESSION_SECRET=
ESIGNET_ISSUER=https://esignet.benin.mosip.net/v1/esignet
ESIGNET_TOKEN_URL=https://esignet.benin.mosip.net/v1/esignet/oauth/v2/token
ESIGNET_USERINFO_URL=https://esignet.benin.mosip.net/v1/esignet/oidc/userinfo
ESIGNET_JWKS_URL=https://esignet.benin.mosip.net/.well-known/jwks.json
# Must be registered as this client's redirect_uri with eSignet, and must be the
# exact URL your frontend sends when redirecting to /authorize.
ESIGNET_REDIRECT_URI=http://localhost:3000/auth/callback
# Trust unsigned/unverifiable userinfo responses. Required true against
# esignet.benin.mosip.net specifically — verified against a real login, its
# userinfo signing key doesn't match its published JWKS (a known ANIP
# integration guide finding), and its userinfo JWT omits iss/aud entirely.
# Keep false against any deployment where you haven't confirmed the same.
ESIGNET_ALLOW_UNVERIFIED_USERINFO=true
